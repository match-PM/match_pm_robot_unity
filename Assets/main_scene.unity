  PluginText: "<gazebo reference=\"laser_top_link\">\n  <sensor name=\"laser_top\"
    type=\"gpu_ray\">\n    <pose>0 0 0 0 0 0</pose>\n    <visualize>true</visualize>\n   
    <update_rate>40</update_rate>\n    <ray>\n      <scan>\n        <horizontal>\n         
    <samples>720</samples>\n          <resolution>1</resolution>\n          <min_angle>-0.1</min_angle>\n         
    <max_angle>0.1</max_angle>\n        </horizontal>\n      </scan>\n      <range>\n       
    <min>0.0057</min>\n        <max>0.0063</max>\n        <resolution>0.0001</resolution>\n     
    </range>\n    </ray>\n    <plugin filename=\"libgazebo_ros_gpu_laser.so\" name=\"gazebo_ros_head_hokuyo_controller\">\n     
    <topicName>laser/scan</topicName>\n      <frameName>laser_top_link</frameName>\n   
    </plugin>\n  </sensor>\n</gazebo>"
